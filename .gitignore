# --- Dependencies ---
# This ignores node_modules in the root, backend, and frontend folders
node_modules/
backend/node_modules/
frontend/node_modules/

# --- Environment Variables (Security) ---
# This protects your MongoDB credentials
.env
backend/.env
frontend/.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Production Builds ---
# This ignores the folder created when you run 'npm run build' in React
frontend/dist/
frontend/build/

# --- Logs & System Files ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.DS_Store
Thumbs.db

# --- Editor Settings ---
.vscode/
.idea/
*.swp
*.bak